# Sao chép file này thành .env.ai.local rồi chỉ điền key ở máy của bạn.
# Không commit .env.ai.local. Có thể đổi model sau khi lệnh test liệt kê model khả dụng.

AI_TEST_PROMPT=Chỉ trả lời một câu tiếng Việt ngắn: Shoyru đã sẵn sàng.
AI_TEST_TIMEOUT_MS=30000
AI_TEST_REQUESTS=1
AI_TEST_CONCURRENCY=1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

KILO_API_KEY=
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
KILO_MODEL=kilo-auto/free

RADOX_API_KEY=
RADOX_BASE_URL=https://radoxai.com/v1
RADOX_MODEL=

CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=openai/gpt-oss-120b:fastest

COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com/v2
COHERE_MODEL=command-a-03-2025

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest

SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=

VERCEL_AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
VERCEL_AI_GATEWAY_MODEL=openai/gpt-oss-20b

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
